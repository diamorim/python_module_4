#!/usr/bin/env python3
import sys
import typing

def ft_ancient_text():
    if len(sys.argv) != 2:
        print("number of arguments are invalid")
        return
    try:
        file = open(sys.argv[1], "r")
    except FileNotFoundError:
        print("File was not found")
        return
    in_file = file.read()
    print("=== Cyber Archives Recovery ===")
    print(f"Accessing file `{file.name}` ")
    print("---")
    fragment = 0
    print(f"[FRAGMENT {fragment}]: ", end="")
    for char in in_file:
        if char == '\n':
            fragment += 1
            print(f"\n[FRAGMENT {fragment}]: ", end="")
        if char != '\n':
            print(char, end="")
    file.close()
    print("\n---")
    print(f"File '{file.name}' closed.")
    return in_file

def ft_archive_creation():
    file_content = ft_ancient_text()

    file_name = input("new file name:")
    if file_name == "":
        print("not saving any data")
        return
    try:
        file = open(file_name, "x")
    except FileExistsError:
        file = open(file_name, "w")
    i = 0
    while i < len(file_content):
        if file_content[i] == '\n':
            file.write("#")
        file.write(file_content[i])
        i += 1
    file.write("#")
    print(f"file {file_name} saved")

if __name__ == "__main__":
	ft_archive_creation()